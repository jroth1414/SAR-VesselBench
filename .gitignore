# Never commit data, runs, or heavy artifacts (DEVPLAN ground rule 11 / AGENTS.md).
# data/* (not data/) so the three frozen split/stats artifacts CAN be
# committed once they exist — everything else under data/ stays ignored.
data/*
!data/splits.json
!data/stats.json
!data/lsssdd_split.json
runs/
*.pt
*.pth
*.ckpt
*.tif
*.tiff
*.parquet

# Python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv*/
venv/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Office lock/owner files
~$*
