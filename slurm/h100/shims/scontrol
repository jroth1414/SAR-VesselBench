#!/usr/bin/env bash
# Defer Lightning's child-level auto-requeue until the outer batch confirms
# every running H100 cell has a durable checkpoint.
set -euo pipefail

if [[ "$#" -ne 2 || "$1" != "requeue" ]]; then
  echo "refusing scontrol in a native H100 training child; outer batch owns Slurm control" >&2
  exit 70
fi

request_dir="${H100_REQUEUE_REQUEST_DIR:?H100_REQUEUE_REQUEST_DIR missing in child}"
gpu="${CUDA_VISIBLE_DEVICES:?CUDA_VISIBLE_DEVICES missing in child}"
job_id="${SLURM_JOB_ID:?SLURM_JOB_ID missing in child}"

if [[ ! -d "$request_dir" || -L "$request_dir" ]]; then
  echo "refusing unsafe H100 requeue-request directory" >&2
  exit 70
fi
if [[ ! "$gpu" =~ ^[0-7]$ ]]; then
  echo "refusing invalid allocation-local GPU index in H100 child" >&2
  exit 70
fi
if [[ "$2" != "$job_id" ]]; then
  echo "refusing H100 child requeue request for a different Slurm job" >&2
  exit 70
fi

temporary="$(mktemp "$request_dir/.gpu-${gpu}.request.XXXXXX")"
trap 'rm -f -- "$temporary"' EXIT
chmod 0600 "$temporary"
printf '%s\n' "$job_id" > "$temporary"
mv -f -- "$temporary" "$request_dir/gpu-${gpu}.request"
trap - EXIT

# Returning success tells Lightning its request was accepted. The request is
# only a durable checkpoint-barrier marker; this shim never calls real scontrol.
