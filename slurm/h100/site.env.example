# Copy to slurm/h100/site.env on the submission host.  The real file is
# ignored and may contain site paths/account details; never commit it.

# Approved Slurm defaults (submit.sh passes these explicitly too).
H100_ACCOUNT=geofam
H100_PARTITION=minor-use-case
H100_RESERVATION=geofam
H100_PROJECT=xview3
H100_PROJECT_ROOT=/path/to/cloned/xView3
H100_JOB_LOG_DIR=/path/to/persistent/slurm-logs
H100_MAIL_USER=you@example.edu
H100_MAIL_TYPE=ALL
H100_TRANSFER_PYTHON=/path/to/transfer-python-3.11/bin/python

# Handoff package created by `python -m scripts.handoff`.
H100_PACKAGE_ROOT=/path/to/xview3-h100-package
H100_REPO_BUNDLE=/path/to/xview3-h100-package/code/xview3.bundle
H100_REPO_BUNDLE_SHA256=REPLACE_WITH_64_HEX
H100_MANIFEST_SHA256=REPLACE_WITH_64_HEX
H100_READY_SHA256=REPLACE_WITH_64_HEX
H100_SHA256SUMS_SHA256=REPLACE_WITH_64_HEX

# Persistently built SIF and receipt.  The base OCI is immutable and tracked
# in containers/h100-strict-fp32.def.
H100_SIF=/path/to/xview3-h100-fp32.sif
H100_SIF_SHA256=REPLACE_WITH_64_HEX
H100_SIF_BUILD_JSON=/path/to/xview3-h100-fp32.sif.build.json
H100_SIF_BUILD_SHA256=REPLACE_WITH_64_HEX
H100_ENV_LOCK_SHA256=7c651f762b84801fcdf50a48accca05911b2b7f6bc1c536cb1acce0d7fa22154
H100_BASE_OCI=python:3.11.15-slim-bookworm@sha256:28255a3ace7eb4c48bc1b57b90af29e1bc82b4fd6c60614a8e3dce61b87ff941

# Persistent result roots.  H100_RUNS_ROOT must be distinct from live V100
# runs.  References are read-only inputs to the cutover guard.
H100_RUNS_ROOT=/path/to/persistent/xview3-h100-runs
H100_REFERENCES_ROOT=/path/to/fresh-v100-reference-runs
H100_CAMPAIGN_ID=xview3-h100-fp32-20260727
H100_REFERENCE_CAMPAIGN_ID=fresh34-v100-fp32-20260726
H100_EXPECTED_GIT_SHA=REPLACE_WITH_SPRINT_7D_40_HEX
H100_EXPECTED_REFERENCE_GIT_SHA=48e10534a8c7baf0662acd548f52928da69f23c8

# Two-step operator cutover. Run `submit.sh cutover-check` first. Only after
# gracefully stopping and archiving the source V100 core diagnostics may a
# human create V100_CORE_ARCHIVED.json from the tracked schema and fill these
# out-of-band hashes. H100 tooling validates but never creates this receipt.
H100_CUTOVER_READY=/path/to/persistent/xview3-h100-runs/.h100/CUTOVER_READY.json
H100_CUTOVER_READY_SHA256=REPLACE_AFTER_CUTOVER_CHECK_WITH_64_HEX
H100_V100_CORE_ARCHIVED=/path/to/operator-attestations/V100_CORE_ARCHIVED.json
H100_V100_CORE_ARCHIVED_SHA256=REPLACE_WITH_64_HEX
H100_V100_ARCHIVE_MANIFEST=/path/to/v100-core-archive/manifest.json
H100_V100_ARCHIVE_MANIFEST_SHA256=REPLACE_WITH_64_HEX

# Frozen sprint-7c study artifacts, in acceptance.py FROZEN_PATHS order.
H100_DETECTOR_SHA256=c42ae65bf9045cc93f0d73ae1437b2f6a1300670cb49d8e93f83a39d58a62a12
H100_SCORER_SHA256=85dec7ab083b531547fe81fea5aa02e4d828457ff157619afae29981cf49cd32
H100_SPLITS_SHA256=0d201003999b6e634bdb3f9cccaedbd391b9d0cdcdb7f9370470d56a5e391db6
H100_STATS_SHA256=8e7691002e540f7274f9e1d67812fe8ae2b6c45775a6e9072a5177b7fadb4490
H100_LSSSDD_SHA256=ae6d0343d021341d58c2d037e20eb9a9f4e67ace3b7c677439973838fd1473a3

# Refresh this measured V100 forecast before both acceptance and cutover-check;
# the latter refuses a stale H100 speed advantage before V100 can be stopped.
H100_REMAINING_V100_WALL_HOURS=REPLACE_WITH_CURRENT_HOURS

# Reverse package uses the Box/preflight part limit recorded for this site.
H100_RESULT_PACKAGE=/path/to/outgoing/xview3-h100-results-FULL40CHARSHA-IDENTITY64HEX
H100_MAX_PART_BYTES=REPLACE_WITH_PREFLIGHT_INTEGER
BOX_JWT_CONFIG=/path/to/untracked/box-jwt-config.json
BOX_FOLDER_ID=REPLACE_WITH_BOX_FOLDER_ID

# Site executable paths.
H100_APPTAINER=apptainer
H100_REAL_SCONTROL=/usr/bin/scontrol
