# Copy to slurm/h100/site.env on the submission host.  The real file is
# ignored and may contain site paths/account details; never commit it.

# Approved Slurm defaults (submit.sh passes these explicitly too).
H100_ACCOUNT=geofam
H100_PARTITION=minor-use-case
H100_RESERVATION=geofam
H100_PROJECT=xview3
H100_PROJECT_ROOT=/path/to/cloned/xView3
H100_JOB_LOG_DIR=/path/to/persistent/slurm-logs
H100_MAIL_USER=you@example.edu
H100_MAIL_TYPE=ALL
H100_TRANSFER_PYTHON=/path/to/transfer-python-3.11/bin/python

# Immutable Sprint 7d data/wheelhouse payload.  Its historical bundle is
# verified against its own manifest but is never used for the Sprint 7f clone.
H100_BASE_PACKAGE_ROOT=/path/to/xview3-h100-package
H100_BASE_PACKAGE_ID=xview3-h100-fp32-2726199efcebbebc89156e708b89df2a3415468a
H100_BASE_GIT_SHA=2726199efcebbebc89156e708b89df2a3415468a
H100_BASE_REPO_BUNDLE_SHA256=df21d64cd7ba2d884fcb4a454c46106b39a6c604459861681e2823ac460f2f4e
H100_BASE_MANIFEST_SHA256=fccb0b505c89836a148afec709bb799f7af4908d955ea1b142e153154d830896
H100_BASE_READY_SHA256=b0d6ee18f9ddbd0d604cbea06610dcdbae6a9eb6d1f5ff3ea3431bd9e2d55f81
H100_BASE_SHA256SUMS_SHA256=21c83b2e3b1b9d67bf00b8abca3ce267a5efd9362c1206b8d29ab21ca3e2d396
H100_WHEELHOUSE=/path/to/verified-base-extraction/environment/wheelhouse
H100_WHEELHOUSE_SHA256=REPLACE_WITH_64_HEX
H100_BASE_EXTRACTION_RECEIPT=/path/to/verified-base-extraction/HANDOFF_EXTRACTED.json
H100_BASE_EXTRACTION_RECEIPT_SHA256=REPLACE_WITH_64_HEX

# Small Sprint 7f evaluation-contract runtime amendment. This separate package
# contains the only Git bundle cloned for H100 execution plus the source-built
# TRAIN+fixed-DEV8 label view; it contains no TEST/eval-final row or raster.
H100_RUNTIME_PACKAGE_ROOT=/path/to/xview3-h100-runtime-amendment
H100_RUNTIME_PACKAGE_ID=REPLACE_WITH_RUNTIME_PACKAGE_ID
H100_RUNTIME_GIT_SHA=REPLACE_WITH_SPRINT_7F_40_HEX
H100_RUNTIME_BUNDLE=/path/to/extracted-runtime-amendment/code/xview3-runtime.bundle
H100_RUNTIME_BUNDLE_SHA256=REPLACE_WITH_64_HEX
H100_RUNTIME_MANIFEST_SHA256=REPLACE_WITH_64_HEX
H100_RUNTIME_READY_SHA256=REPLACE_WITH_64_HEX
H100_RUNTIME_SHA256SUMS_SHA256=REPLACE_WITH_64_HEX

# Persistently built, non-relocatable native venv and receipt.  Build it at
# this final path from the verified Sprint 7d wheelhouse.  H100_BASE_PYTHON
# is Judy's exact Python 3.11.13 executable, not an image or environment label.
# Its shared libpython directory is snapshotted and used as the complete
# LD_LIBRARY_PATH because Slurm deliberately submits with --export=NONE.
H100_BASE_PYTHON=/cm/shared/mitre-apps/python/3.11.13/build/bin/python3.11
H100_BASE_PYTHON_LIB_DIR=/cm/shared/mitre-apps/python/3.11.13/build/lib
H100_BASE_PYTHON_SHA256=REPLACE_WITH_64_HEX
H100_BASE_PYTHON_RUNTIME_SHA256=REPLACE_WITH_64_HEX
H100_VENV_ROOT=/path/to/persistent/venvs/xview3-h100-fp32
H100_VENV_SHA256=REPLACE_WITH_64_HEX
H100_VENV_BUILD_JSON=/path/to/persistent/venvs/xview3-h100-fp32.build.json
H100_VENV_BUILD_SHA256=REPLACE_WITH_64_HEX
H100_ENV_LOCK_SHA256=7c651f762b84801fcdf50a48accca05911b2b7f6bc1c536cb1acce0d7fa22154

# Judy and the live V100 host have completely separate filesystems. This exact
# literal is required and enters every immutable compute-site snapshot. Never
# substitute a dummy Judy directory for the live V100 runs tree.
H100_V100_CONTROL_PLANE=box-transfer-v1

# Judy-owned persistent H100 outputs. submit.sh rejects equality/ancestor
# overlap between these two roots and between either root and the immutable
# repo, base/runtime packages, wheelhouse, or sealed venv before its first write.
H100_RUNS_ROOT=/path/to/persistent/xview3-h100-runs
H100_CAMPAIGN_ID=xview3-h100-fp32-20260804
H100_EXPECTED_GIT_SHA=REPLACE_WITH_SPRINT_7F_40_HEX

# Corrected R2/R3 control package transferred V100 -> Judy through its own
# empty Box child folder. Record these exact out-of-band values from
# `build-control`/`verify-control`; `download-control` verifies the transfer,
# and cutover-check rejects a different internally consistent package.
H100_REFERENCES_PACKAGE_ROOT=/path/to/xview3-control-references-IDENTITY64HEX
H100_REFERENCES_PACKAGE_ID=xview3-control-references-IDENTITY64HEX
H100_REFERENCES_PRODUCER_GIT_SHA=REPLACE_WITH_SPRINT_7F_40_HEX
H100_REFERENCES_IDENTITY_SHA256=REPLACE_WITH_64_HEX
H100_REFERENCES_MANIFEST_SHA256=REPLACE_WITH_64_HEX
H100_REFERENCES_READY_SHA256=REPLACE_WITH_64_HEX
H100_REFERENCES_SHA256SUMS_SHA256=REPLACE_WITH_64_HEX
H100_REFERENCE_CAMPAIGN_ID=sprint7f-v100-references-20260804
H100_EXPECTED_REFERENCE_GIT_SHA=REPLACE_WITH_SPRINT_7F_40_HEX
H100_V100_CORE_CAMPAIGN_ID=fresh34-v100-fp32-20260726
H100_V100_CORE_GIT_SHA=48e10534a8c7baf0662acd548f52928da69f23c8

# Run `submit.sh cutover-check`, transfer CUTOVER_READY Judy -> V100, and have
# the human operator create the tracked diagnostic-isolation attestation while
# leaving the live V100 campaign untouched. Return its exact control package
# V100 -> Judy, then fill these out-of-band values before `submit.sh campaign`.
H100_CUTOVER_READY=/path/to/persistent/xview3-h100-runs/.h100/CUTOVER_READY.json
H100_CUTOVER_READY_SHA256=REPLACE_AFTER_CUTOVER_CHECK_WITH_64_HEX
H100_DIAGNOSTIC_ISOLATION_PACKAGE_ROOT=/path/to/xview3-control-diagnostic-isolation-IDENTITY64HEX
H100_DIAGNOSTIC_ISOLATION_PACKAGE_ID=xview3-control-diagnostic-isolation-IDENTITY64HEX
H100_DIAGNOSTIC_ISOLATION_PRODUCER_GIT_SHA=REPLACE_WITH_SPRINT_7F_40_HEX
H100_DIAGNOSTIC_ISOLATION_IDENTITY_SHA256=REPLACE_WITH_64_HEX
H100_DIAGNOSTIC_ISOLATION_MANIFEST_SHA256=REPLACE_WITH_64_HEX
H100_DIAGNOSTIC_ISOLATION_READY_SHA256=REPLACE_WITH_64_HEX
H100_DIAGNOSTIC_ISOLATION_SHA256SUMS_SHA256=REPLACE_WITH_64_HEX

# Frozen sprint-7c study artifacts, in acceptance.py FROZEN_PATHS order.
H100_DETECTOR_SHA256=c42ae65bf9045cc93f0d73ae1437b2f6a1300670cb49d8e93f83a39d58a62a12
H100_SCORER_SHA256=85dec7ab083b531547fe81fea5aa02e4d828457ff157619afae29981cf49cd32
H100_SPLITS_SHA256=0d201003999b6e634bdb3f9cccaedbd391b9d0cdcdb7f9370470d56a5e391db6
H100_STATS_SHA256=8e7691002e540f7274f9e1d67812fe8ae2b6c45775a6e9072a5177b7fadb4490
H100_LSSSDD_SHA256=ae6d0343d021341d58c2d037e20eb9a9f4e67ace3b7c677439973838fd1473a3

# Refresh this measured V100 diagnostic forecast before acceptance and
# cutover-check. This gate does not stop, signal, or modify V100.
H100_REMAINING_V100_WALL_HOURS=REPLACE_WITH_CURRENT_HOURS
# Use complete-non-reportable-diagnostic only with exactly 0 remaining hours.
H100_CURRENT_V100_DIAGNOSTIC_STATUS=continues-running-non-reportable-diagnostic

# Reverse package uses the Box/preflight part limit recorded for this site.
H100_RESULT_PACKAGE=/path/to/outgoing/xview3-h100-results-FULL40CHARSHA-IDENTITY64HEX
H100_MAX_PART_BYTES=REPLACE_WITH_PREFLIGHT_INTEGER
# Source BOX_JWT_CONFIG and BOX_FOLDER_ID only from the separate untracked
# transfer environment when running Box commands. Never put them in this
# Slurm site file or a compute-site snapshot.

# Site executable paths.
H100_REAL_SCONTROL=/usr/bin/scontrol
