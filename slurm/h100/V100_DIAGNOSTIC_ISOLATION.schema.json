{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xview3.local/schemas/V100_DIAGNOSTIC_ISOLATION.schema.json",
  "title": "V100 diagnostic isolation attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "created_utc",
    "attestation",
    "cutover_ready_sha256",
    "h100",
    "v100",
    "namespaces",
    "h100_suppression",
    "post_diagnostic"
  ],
  "properties": {
    "schema": {"const": 1},
    "status": {"const": "v100-diagnostic-isolated"},
    "created_utc": {"type": "string", "format": "date-time"},
    "attestation": {"const": "external-human-operator"},
    "cutover_ready_sha256": {"$ref": "#/$defs/sha256"},
    "h100": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptance_uuid", "git_sha", "campaign_id"],
      "properties": {
        "acceptance_uuid": {"type": "string", "minLength": 1},
        "git_sha": {"$ref": "#/$defs/git_sha"},
        "campaign_id": {"$ref": "#/$defs/campaign_id"}
      }
    },
    "v100": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_sha",
        "campaign_id",
        "execution_status",
        "diagnostic_status"
      ],
      "properties": {
        "git_sha": {"$ref": "#/$defs/git_sha"},
        "campaign_id": {"$ref": "#/$defs/campaign_id"},
        "execution_status": {
          "enum": [
            "continues-running-non-reportable-diagnostic",
            "complete-non-reportable-diagnostic"
          ]
        },
        "diagnostic_status": {"const": "non-reportable-diagnostic"}
      }
    },
    "namespaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v100_runs_root", "h100_runs_root", "disjoint"],
      "properties": {
        "v100_runs_root": {"$ref": "#/$defs/absolute_path"},
        "h100_runs_root": {"$ref": "#/$defs/absolute_path"},
        "disjoint": {"const": true}
      }
    },
    "h100_suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v100_completions_suppress_h100",
        "v100_checkpoints_resume_h100",
        "mixed_hardware_curve_allowed"
      ],
      "properties": {
        "v100_completions_suppress_h100": {"const": false},
        "v100_checkpoints_resume_h100": {"const": false},
        "mixed_hardware_curve_allowed": {"const": false}
      }
    },
    "post_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_stop_archive", "required_before_h100_campaign"],
      "properties": {
        "safe_stop_archive": {"const": "optional-after-diagnostic"},
        "required_before_h100_campaign": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "campaign_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^/[^\\n]+[^/]$"
    }
  }
}
