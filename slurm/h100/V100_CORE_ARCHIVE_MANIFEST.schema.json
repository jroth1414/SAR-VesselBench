{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xview3.local/schemas/V100_CORE_ARCHIVE_MANIFEST.schema.json",
  "title": "Archived V100 core diagnostic manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "scope",
    "diagnostic_status",
    "git_sha",
    "campaign_id",
    "stopped_utc",
    "archived_utc",
    "file_count",
    "total_bytes"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "status": {
      "const": "v100-core-diagnostics-archived"
    },
    "scope": {
      "const": "v100-core-diagnostics"
    },
    "diagnostic_status": {
      "const": "non-reportable-diagnostic"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "stopped_utc": {
      "type": "string",
      "format": "date-time"
    },
    "archived_utc": {
      "type": "string",
      "format": "date-time"
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "empty_reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "file_count": {
            "const": 0
          },
          "total_bytes": {
            "const": 0
          }
        },
        "required": [
          "file_count",
          "total_bytes"
        ]
      },
      "then": {
        "required": [
          "empty_reason"
        ]
      },
      "else": {
        "properties": {
          "file_count": {
            "minimum": 1
          },
          "total_bytes": {
            "minimum": 1
          }
        },
        "not": {
          "required": [
            "empty_reason"
          ]
        }
      }
    }
  ]
}
